{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"]},"docs":[{"location":"","title":"\u8fd9\u662f\u963f\u5f3a\u7684\u535a\u5ba2","text":"<p>\u4f60\u597d\ud83d\udc4b</p> <p>\u65bd\u5de5\u4e2d\ud83c\udfd7\ufe0f\u3002\u3002\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/","title":"Preface","text":""},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_1","title":"\u524d\u8a00","text":"<p>\u4f60\u53ef\u80fd\u60f3\u77e5\u9053\u6211\u4eec\u662f\u8c01\uff0c\u4ee5\u53ca\u4e3a\u4ec0\u4e48\u5199\u4e86\u8fd9\u672c\u4e66\u3002</p> <p>\u5728 Harry \u7684\u4e0a\u4e00\u672c\u4e66\u300aTest-Driven Development with Python\u300b\uff08O'Reilly \u51fa\u7248\uff09\u7684\u7ed3\u5c3e\uff0c\u4ed6\u63d0\u51fa\u4e86\u4e00\u4e9b\u5173\u4e8e\u67b6\u6784\u7684\u95ee\u9898\uff0c\u6bd4\u5982\uff1a\u5982\u4f55\u4ee5\u6613\u4e8e\u6d4b\u8bd5\u7684\u65b9\u5f0f\u6784\u5efa\u5e94\u7528\u7a0b\u5e8f\uff1f\u66f4\u5177\u4f53\u5730\u8bf4\uff0c\u5982\u4f55\u786e\u4fdd\u6838\u5fc3\u4e1a\u52a1\u903b\u8f91\u88ab\u5355\u5143\u6d4b\u8bd5\u8986\u76d6\uff0c\u540c\u65f6\u5c3d\u91cf\u51cf\u5c11\u96c6\u6210\u6d4b\u8bd5\u548c\u7aef\u5230\u7aef\u6d4b\u8bd5\u7684\u6570\u91cf\uff1f\u4ed6\u6a21\u7cca\u5730\u63d0\u5230\u4e86\u201c\u516d\u8fb9\u5f62\u67b6\u6784\u201d\u3001\u201c\u7aef\u53e3\u4e0e\u9002\u914d\u5668\u201d\u548c\u201c\u529f\u80fd\u6838\u5fc3\uff0c\u547d\u4ee4\u5f0f\u5916\u58f3\u201d\u7b49\u6982\u5ff5\uff0c\u4f46\u8001\u5b9e\u8bf4\uff0c\u4ed6\u5e76\u4e0d\u771f\u6b63\u7406\u89e3\u8fd9\u4e9b\uff0c\u4e5f\u6ca1\u6709\u5728\u5b9e\u8df5\u4e2d\u5e94\u7528\u8fc7\u3002</p> <p>\u540e\u6765\uff0c\u4ed6\u5e78\u8fd0\u5730\u9047\u5230\u4e86 Bob\uff0cBob\u5bf9\u8fd9\u4e9b\u95ee\u9898\u90fd\u6709\u7b54\u6848\u3002</p> <p>Bob \u6210\u4e3a\u4e00\u540d\u8f6f\u4ef6\u67b6\u6784\u5e08\u662f\u56e0\u4e3a\u56e2\u961f\u4e2d\u6ca1\u6709\u4eba\u505a\u8fd9\u4ef6\u4e8b\u3002\u867d\u7136\u4ed6\u4e00\u5f00\u59cb\u5e76\u4e0d\u64c5\u957f\uff0c\u4f46\u5e78\u8fd0\u7684\u662f\uff0c\u4ed6\u9047\u5230\u4e86 Ian Cooper\uff0c\u540e\u8005\u6559\u4f1a\u4e86\u4ed6\u65b0\u7684\u7f16\u7801\u548c\u601d\u8003\u65b9\u5f0f\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_2","title":"\u7ba1\u7406\u590d\u6742\u6027\uff0c\u89e3\u51b3\u4e1a\u52a1\u95ee\u9898","text":"<p>\u6211\u4eec\u90fd\u5728 MADE.com \u5de5\u4f5c\uff0c\u8fd9\u662f\u4e00\u5bb6\u6b27\u6d32\u7684\u5728\u7ebf\u5bb6\u5177\u9500\u552e\u516c\u53f8\u3002\u5728\u90a3\u91cc\uff0c\u6211\u4eec\u5e94\u7528\u672c\u4e66\u4e2d\u7684\u6280\u672f\u6765\u6784\u5efa\u5206\u5e03\u5f0f\u7cfb\u7edf\uff0c\u4ee5\u89e3\u51b3\u73b0\u5b9e\u4e16\u754c\u7684\u4e1a\u52a1\u95ee\u9898\u3002\u6211\u4eec\u7684\u793a\u4f8b\u9886\u57df\u662f Bob \u4e3a MADE \u6784\u5efa\u7684\u7b2c\u4e00\u4e2a\u7cfb\u7edf\uff0c\u800c\u8fd9\u672c\u4e66\u662f\u6211\u4eec\u4e3a\u65b0\u52a0\u5165\u56e2\u961f\u7684\u5f00\u53d1\u4eba\u5458\u7f16\u5199\u7684\u6559\u6750\u3002</p> <p>MADE.com \u8fd0\u8425\u7740\u4e00\u4e2a\u5168\u7403\u4f9b\u5e94\u94fe\uff0c\u6d89\u53ca\u8d27\u8fd0\u5408\u4f5c\u4f19\u4f34\u548c\u5236\u9020\u5546\u3002\u4e3a\u4e86\u964d\u4f4e\u6210\u672c\uff0c\u6211\u4eec\u52aa\u529b\u4f18\u5316\u5e93\u5b58\u4ea4\u4ed8\u5230\u4ed3\u5e93\u7684\u65f6\u95f4\uff0c\u907f\u514d\u79ef\u538b\u672a\u552e\u51fa\u7684\u5546\u54c1\u3002</p> <p>\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u4f60\u60f3\u8981\u7684\u6c99\u53d1\u4f1a\u5728\u4f60\u51b3\u5b9a\u8d2d\u4e70\u7684\u90a3\u5929\u5230\u6e2f\uff0c\u6211\u4eec\u4f1a\u76f4\u63a5\u9001\u8d27\u4e0a\u95e8\uff0c\u800c\u4e0d\u9700\u8981\u5b58\u50a8\u3002\u5f53\u8d27\u7269\u9700\u8981\u4e09\u4e2a\u6708\u624d\u80fd\u901a\u8fc7\u96c6\u88c5\u7bb1\u8239\u5230\u8fbe\u65f6\uff0c\u65f6\u95f4\u5b89\u6392\u662f\u4e00\u4e2a\u68d8\u624b\u7684\u5e73\u8861\u95ee\u9898\u3002\u5728\u8fd9\u4e2a\u8fc7\u7a0b\u4e2d\uff0c\u8d27\u7269\u53ef\u80fd\u4f1a\u635f\u574f\u3001\u906d\u9047\u98ce\u66b4\u5ef6\u8bef\u3001\u7269\u6d41\u5408\u4f5c\u4f19\u4f34\u5904\u7406\u4e0d\u5f53\u3001\u6587\u4ef6\u4e22\u5931\u3001\u5ba2\u6237\u6539\u53d8\u4e3b\u610f\u4fee\u6539\u8ba2\u5355\u7b49\u7b49\u3002</p> <p>\u6211\u4eec\u901a\u8fc7\u6784\u5efa\u667a\u80fd\u8f6f\u4ef6\u6765\u89e3\u51b3\u8fd9\u4e9b\u95ee\u9898\uff0c\u8fd9\u4e9b\u8f6f\u4ef6\u4ee3\u8868\u4e86\u73b0\u5b9e\u4e16\u754c\u4e2d\u7684\u64cd\u4f5c\uff0c\u4ee5\u4fbf\u5c3d\u53ef\u80fd\u591a\u5730\u81ea\u52a8\u5316\u4e1a\u52a1\u6d41\u7a0b\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#python","title":"\u4e3a\u4ec0\u4e48\u9009\u62e9 Python\uff1f","text":"<p>\u5982\u679c\u4f60\u6b63\u5728\u9605\u8bfb\u8fd9\u672c\u4e66\uff0c\u6211\u4eec\u53ef\u80fd\u4e0d\u9700\u8981\u8bf4\u670d\u4f60 Python \u5f88\u68d2\uff0c\u6240\u4ee5\u771f\u6b63\u7684\u95ee\u9898\u662f\u201c\u4e3a\u4ec0\u4e48 Python \u793e\u533a\u9700\u8981\u8fd9\u6837\u4e00\u672c\u4e66\uff1f\u201d\u7b54\u6848\u4e0e Python \u7684\u6d41\u884c\u548c\u6210\u719f\u5ea6\u6709\u5173\uff1a\u5c3d\u7ba1 Python \u53ef\u80fd\u662f\u4e16\u754c\u4e0a\u589e\u957f\u6700\u5feb\u7684\u7f16\u7a0b\u8bed\u8a00\uff0c\u5e76\u4e14\u63a5\u8fd1\u7edd\u5bf9\u6d41\u884c\u5ea6\u7684\u9876\u7aef\uff0c\u4f46\u5b83\u624d\u521a\u521a\u5f00\u59cb\u89e3\u51b3 C# \u548c Java \u4e16\u754c\u591a\u5e74\u6765\u4e00\u76f4\u5728\u5904\u7406\u7684\u95ee\u9898\u3002\u521d\u521b\u516c\u53f8\u6210\u957f\u4e3a\u771f\u6b63\u7684\u4f01\u4e1a\uff1bWeb \u5e94\u7528\u548c\u811a\u672c\u81ea\u52a8\u5316\u6b63\u5728\u6210\u4e3a\uff08\u5c0f\u58f0\u8bf4\uff09\u4f01\u4e1a\u8f6f\u4ef6\u3002</p> <p>\u5728 Python \u4e16\u754c\u4e2d\uff0c\u6211\u4eec\u7ecf\u5e38\u5f15\u7528\u201cPython \u4e4b\u7985\u201d\uff1a\u201c\u5e94\u8be5\u6709\u4e00\u79cd\u2014\u2014\u6700\u597d\u53ea\u6709\u4e00\u79cd\u2014\u2014\u663e\u800c\u6613\u89c1\u7684\u65b9\u6cd5\u6765\u505a\u5230\u5b83\u3002\u201d\u4e0d\u5e78\u7684\u662f\uff0c\u968f\u7740\u9879\u76ee\u89c4\u6a21\u7684\u6269\u5927\uff0c\u6700\u660e\u663e\u7684\u65b9\u6cd5\u5e76\u4e0d\u603b\u662f\u80fd\u5e2e\u52a9\u4f60\u7ba1\u7406\u590d\u6742\u6027\u548c\u4e0d\u65ad\u53d8\u5316\u7684\u9700\u6c42\u3002</p> <p>\u6211\u4eec\u5728\u672c\u4e66\u4e2d\u8ba8\u8bba\u7684\u6280\u672f\u548c\u6a21\u5f0f\u90fd\u4e0d\u662f\u65b0\u7684\uff0c\u4f46\u5b83\u4eec\u5927\u591a\u5bf9 Python \u4e16\u754c\u6765\u8bf4\u662f\u65b0\u7684\u3002\u8fd9\u672c\u4e66\u5e76\u4e0d\u662f Eric Evans \u7684\u300a\u9886\u57df\u9a71\u52a8\u8bbe\u8ba1\u300b\u6216 Martin Fowler \u7684\u300a\u4f01\u4e1a\u5e94\u7528\u67b6\u6784\u6a21\u5f0f\u300b\uff08\u5747\u7531 Addison-Wesley Professional \u51fa\u7248\uff09\u7b49\u7ecf\u5178\u8457\u4f5c\u7684\u66ff\u4ee3\u54c1\u2014\u2014\u6211\u4eec\u7ecf\u5e38\u5f15\u7528\u5e76\u9f13\u52b1\u4f60\u53bb\u9605\u8bfb\u3002</p> <p>\u4f46\u6240\u6709\u8fd9\u4e9b\u7ecf\u5178\u4ee3\u7801\u793a\u4f8b\u901a\u5e38\u90fd\u662f\u7528 Java \u6216 C++/# \u7f16\u5199\u7684\uff0c\u5982\u679c\u4f60\u662f\u4e00\u4e2a Python \u5f00\u53d1\u8005\uff0c\u5e76\u4e14\u5f88\u4e45\u6ca1\u6709\u4f7f\u7528\u8fd9\u4e9b\u8bed\u8a00\uff08\u6216\u8005\u4ece\u672a\u4f7f\u7528\u8fc7\uff09\uff0c\u8fd9\u4e9b\u4ee3\u7801\u6e05\u5355\u53ef\u80fd\u4f1a\u8ba9\u4f60\u611f\u5230\u2026\u2026\u5934\u75bc\u3002\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48 Fowler \u7684\u53e6\u4e00\u672c\u7ecf\u5178\u8457\u4f5c\u300a\u91cd\u6784\u300b\uff08Addison-Wesley Professional \u51fa\u7248\uff09\u7684\u6700\u65b0\u7248\u662f\u7528 JavaScript \u7f16\u5199\u7684\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#tddddd","title":"TDD\u3001DDD \u548c\u4e8b\u4ef6\u9a71\u52a8\u67b6\u6784","text":"<p>\u6309\u77e5\u540d\u5ea6\u6392\u5e8f\uff0c\u6211\u4eec\u77e5\u9053\u7684\u4e09\u79cd\u7ba1\u7406\u590d\u6742\u6027\u7684\u5de5\u5177\u662f\uff1a</p> <ol> <li>\u6d4b\u8bd5\u9a71\u52a8\u5f00\u53d1\uff08TDD\uff09\uff1a\u5e2e\u52a9\u6211\u4eec\u6784\u5efa\u6b63\u786e\u7684\u4ee3\u7801\uff0c\u5e76\u8ba9\u6211\u4eec\u80fd\u591f\u91cd\u6784\u6216\u6dfb\u52a0\u65b0\u529f\u80fd\uff0c\u800c\u4e0d\u7528\u62c5\u5fc3\u56de\u5f52\u95ee\u9898\u3002\u4f46\u5982\u4f55\u5145\u5206\u5229\u7528\u6d4b\u8bd5\u662f\u4e00\u4e2a\u6311\u6218\uff1a\u5982\u4f55\u786e\u4fdd\u6d4b\u8bd5\u5c3d\u53ef\u80fd\u5feb\u5730\u8fd0\u884c\uff1f\u5982\u4f55\u901a\u8fc7\u5feb\u901f\u3001\u65e0\u4f9d\u8d56\u7684\u5355\u5143\u6d4b\u8bd5\u83b7\u5f97\u6700\u5927\u7684\u8986\u76d6\u7387\u548c\u53cd\u9988\uff0c\u540c\u65f6\u5c3d\u91cf\u51cf\u5c11\u7f13\u6162\u3001\u4e0d\u7a33\u5b9a\u7684\u7aef\u5230\u7aef\u6d4b\u8bd5\uff1f</li> <li>\u9886\u57df\u9a71\u52a8\u8bbe\u8ba1\uff08DDD\uff09\uff1a\u8981\u6c42\u6211\u4eec\u4e13\u6ce8\u4e8e\u6784\u5efa\u4e1a\u52a1\u9886\u57df\u7684\u826f\u597d\u6a21\u578b\uff0c\u4f46\u5982\u4f55\u786e\u4fdd\u6a21\u578b\u4e0d\u53d7\u57fa\u7840\u8bbe\u65bd\u95ee\u9898\u7684\u62d6\u7d2f\uff0c\u5e76\u4e14\u4e0d\u4f1a\u53d8\u5f97\u96be\u4ee5\u66f4\u6539\uff1f</li> <li>\u677e\u6563\u8026\u5408\u7684\uff08\u5fae\uff09\u670d\u52a1\u901a\u8fc7\u6d88\u606f\u96c6\u6210\uff08\u6709\u65f6\u79f0\u4e3a\u54cd\u5e94\u5f0f\u5fae\u670d\u52a1\uff09\uff1a\u662f\u7ba1\u7406\u8de8\u591a\u4e2a\u5e94\u7528\u7a0b\u5e8f\u6216\u4e1a\u52a1\u9886\u57df\u7684\u590d\u6742\u6027\u7684\u6210\u719f\u89e3\u51b3\u65b9\u6848\u3002\u4f46\u5982\u4f55\u8ba9\u5b83\u4eec\u4e0e Python \u4e16\u754c\u7684\u73b0\u6709\u5de5\u5177\uff08\u5982 Flask\u3001Django\u3001Celery \u7b49\uff09\u914d\u5408\u4f7f\u7528\u5e76\u4e0d\u603b\u662f\u663e\u800c\u6613\u89c1\u3002</li> </ol> <p>\ud83e\udd14\u6ce8\u610f: \u5982\u679c\u4f60\u4e0d\u4ece\u4e8b\uff08\u6216\u4e0d\u611f\u5174\u8da3\uff09\u5fae\u670d\u52a1\uff0c\u8bf7\u4e0d\u8981\u88ab\u5413\u5230\u3002\u6211\u4eec\u8ba8\u8bba\u7684\u5927\u591a\u6570\u6a21\u5f0f\uff0c\u5305\u62ec\u4e8b\u4ef6\u9a71\u52a8\u67b6\u6784\u7684\u5927\u90e8\u5206\u5185\u5bb9\uff0c\u5b8c\u5168\u9002\u7528\u4e8e\u5355\u4f53\u67b6\u6784\u3002</p> <p>\u672c\u4e66\u7684\u76ee\u6807\u662f\u4ecb\u7ecd\u51e0\u79cd\u7ecf\u5178\u7684\u67b6\u6784\u6a21\u5f0f\uff0c\u5e76\u5c55\u793a\u5b83\u4eec\u5982\u4f55\u652f\u6301 TDD\u3001DDD \u548c\u4e8b\u4ef6\u9a71\u52a8\u670d\u52a1\u3002\u6211\u4eec\u5e0c\u671b\u5b83\u80fd\u6210\u4e3a\u5728 Python \u4e2d\u5b9e\u73b0\u8fd9\u4e9b\u6a21\u5f0f\u7684\u53c2\u8003\uff0c\u5e76\u4f5c\u4e3a\u8fdb\u4e00\u6b65\u7814\u7a76\u7684\u8d77\u70b9\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_3","title":"\u9002\u5408\u7684\u8bfb\u8005","text":"<p>\u6211\u4eec\u5bf9\u4eb2\u7231\u7684\u8bfb\u8005\u6709\u4ee5\u4e0b\u51e0\u70b9\u5047\u8bbe\uff1a</p> <ul> <li>\u4f60\u63a5\u89e6\u8fc7\u4e00\u4e9b\u76f8\u5f53\u590d\u6742\u7684 Python \u5e94\u7528\u7a0b\u5e8f\u3002</li> <li>\u4f60\u7ecf\u5386\u8fc7\u7ba1\u7406\u8fd9\u79cd\u590d\u6742\u6027\u5e26\u6765\u7684\u75db\u82e6\u3002</li> <li>\u4f60\u53ef\u80fd\u5bf9 DDD \u6216\u4efb\u4f55\u7ecf\u5178\u7684\u5e94\u7528\u67b6\u6784\u6a21\u5f0f\u4e00\u65e0\u6240\u77e5\u3002</li> </ul> <p>\u6211\u4eec\u56f4\u7ed5\u4e00\u4e2a\u793a\u4f8b\u5e94\u7528\u7a0b\u5e8f\u5c55\u5f00\u5bf9\u67b6\u6784\u6a21\u5f0f\u7684\u63a2\u7d22\uff0c\u9010\u7ae0\u6784\u5efa\u5b83\u3002\u6211\u4eec\u5728\u5de5\u4f5c\u4e2d\u4f7f\u7528 TDD\uff0c\u56e0\u6b64\u901a\u5e38\u4f1a\u5148\u5c55\u793a\u6d4b\u8bd5\u5217\u8868\uff0c\u7136\u540e\u662f\u5b9e\u73b0\u3002\u5982\u679c\u4f60\u4e0d\u4e60\u60ef\u6d4b\u8bd5\u4f18\u5148\u7684\u5de5\u4f5c\u65b9\u5f0f\uff0c\u4e00\u5f00\u59cb\u53ef\u80fd\u4f1a\u89c9\u5f97\u6709\u70b9\u5947\u602a\uff0c\u4f46\u6211\u4eec\u5e0c\u671b\u4f60\u5f88\u5feb\u5c31\u80fd\u4e60\u60ef\u5728\u201c\u770b\u5230\u4ee3\u7801\u5982\u4f55\u6784\u5efa\u201d\u4e4b\u524d\u201c\u770b\u5230\u4ee3\u7801\u5982\u4f55\u4f7f\u7528\u201d\u3002</p> <p>\u6211\u4eec\u4f7f\u7528\u4e86\u4e00\u4e9b\u7279\u5b9a\u7684 Python \u6846\u67b6\u548c\u6280\u672f\uff0c\u5305\u62ec Flask\u3001SQLAlchemy \u548c pytest\uff0c\u4ee5\u53ca Docker \u548c Redis\u3002\u5982\u679c\u4f60\u5df2\u7ecf\u719f\u6089\u5b83\u4eec\uff0c\u90a3\u5f53\u7136\u66f4\u597d\uff0c\u4f46\u6211\u4eec\u8ba4\u4e3a\u8fd9\u4e0d\u662f\u5fc5\u9700\u7684\u3002\u672c\u4e66\u7684\u4e3b\u8981\u76ee\u6807\u4e4b\u4e00\u662f\u6784\u5efa\u4e00\u79cd\u67b6\u6784\uff0c\u4f7f\u5177\u4f53\u7684\u6280\u672f\u9009\u62e9\u6210\u4e3a\u6b21\u8981\u7684\u5b9e\u73b0\u7ec6\u8282\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_4","title":"\u7b80\u8981\u6982\u8ff0\u4f60\u5c06\u5b66\u5230\u7684\u5185\u5bb9","text":"<p>\u672c\u4e66\u5206\u4e3a\u4e24\u90e8\u5206\uff0c\u4ee5\u4e0b\u662f\u6211\u4eec\u5c06\u6db5\u76d6\u7684\u4e3b\u9898\u53ca\u5176\u6240\u5728\u7684\u7ae0\u8282\u3002</p>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_5","title":"\u7b2c\u4e00\u90e8\u5206","text":"<ul> <li>\u9886\u57df\u5efa\u6a21\u548c DDD\uff08\u7b2c 1\u30012 \u548c 7 \u7ae0\uff09\uff1a\u5728\u67d0\u79cd\u7a0b\u5ea6\u4e0a\uff0c\u6bcf\u4e2a\u4eba\u90fd\u5b66\u5230\u4e86\u590d\u6742\u4e1a\u52a1\u95ee\u9898\u9700\u8981\u5728\u4ee3\u7801\u4e2d\u53cd\u6620\u4e3a\u4e00\u4e2a\u9886\u57df\u6a21\u578b\u7684\u6559\u8bad\u3002\u4f46\u4e3a\u4ec0\u4e48\u603b\u662f\u5f88\u96be\u505a\u5230\u8fd9\u4e00\u70b9\u800c\u4e0d\u88ab\u57fa\u7840\u8bbe\u65bd\u95ee\u9898\u3001Web \u6846\u67b6\u6216\u5176\u4ed6\u4e1c\u897f\u62d6\u7d2f\uff1f\u5728\u7b2c\u4e00\u7ae0\u4e2d\uff0c\u6211\u4eec\u6982\u8ff0\u4e86\u9886\u57df\u5efa\u6a21\u548c DDD\uff0c\u5e76\u5c55\u793a\u4e86\u5982\u4f55\u4ece\u4e00\u4e2a\u6ca1\u6709\u5916\u90e8\u4f9d\u8d56\u7684\u6a21\u578b\u5f00\u59cb\uff0c\u4ee5\u53ca\u5feb\u901f\u7684\u5355\u5143\u6d4b\u8bd5\u3002\u540e\u6765\uff0c\u6211\u4eec\u56de\u5230 DDD \u6a21\u5f0f\uff0c\u8ba8\u8bba\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u805a\u5408\uff0c\u4ee5\u53ca\u8fd9\u79cd\u9009\u62e9\u5982\u4f55\u4e0e\u6570\u636e\u5b8c\u6574\u6027\u95ee\u9898\u76f8\u5173\u3002</li> <li>\u4ed3\u5e93\u3001\u670d\u52a1\u5c42\u548c\u5de5\u4f5c\u5355\u5143\u6a21\u5f0f\uff08\u7b2c 2\u30014 \u548c 5 \u7ae0\uff09\uff1a\u5728\u8fd9\u4e09\u7ae0\u4e2d\uff0c\u6211\u4eec\u4ecb\u7ecd\u4e86\u4e09\u4e2a\u5bc6\u5207\u76f8\u5173\u4e14\u76f8\u4e92\u652f\u6301\u7684\u6a21\u5f0f\uff0c\u4ee5\u5b9e\u73b0\u6211\u4eec\u7684\u76ee\u6807\uff1a\u8ba9\u6a21\u578b\u6446\u8131\u65e0\u5173\u7684\u4f9d\u8d56\u3002\u6211\u4eec\u56f4\u7ed5\u6301\u4e45\u5b58\u50a8\u6784\u5efa\u4e86\u4e00\u4e2a\u62bd\u8c61\u5c42\uff0c\u5e76\u6784\u5efa\u4e86\u4e00\u4e2a\u670d\u52a1\u5c42\u6765\u5b9a\u4e49\u7cfb\u7edf\u7684\u5165\u53e3\u70b9\u5e76\u6355\u83b7\u4e3b\u8981\u7528\u4f8b\u3002\u6211\u4eec\u5c55\u793a\u4e86\u8fd9\u4e00\u5c42\u5982\u4f55\u8f7b\u677e\u6784\u5efa\u7cfb\u7edf\u7684\u8584\u5165\u53e3\u70b9\uff0c\u65e0\u8bba\u662f Flask API \u8fd8\u662f CLI\u3002</li> <li>\u5173\u4e8e\u6d4b\u8bd5\u548c\u62bd\u8c61\u7684\u4e00\u4e9b\u601d\u8003\uff08\u7b2c 3 \u548c 5 \u7ae0\uff09\uff1a\u5728\u4ecb\u7ecd\u4e86\u7b2c\u4e00\u4e2a\u62bd\u8c61\uff08\u4ed3\u5e93\u6a21\u5f0f\uff09\u4e4b\u540e\uff0c\u6211\u4eec\u501f\u6b64\u673a\u4f1a\u8ba8\u8bba\u4e86\u5982\u4f55\u9009\u62e9\u62bd\u8c61\uff0c\u4ee5\u53ca\u5b83\u4eec\u5728\u8f6f\u4ef6\u8026\u5408\u4e2d\u7684\u4f5c\u7528\u3002\u5728\u4ecb\u7ecd\u4e86\u670d\u52a1\u5c42\u6a21\u5f0f\u4e4b\u540e\uff0c\u6211\u4eec\u8c08\u5230\u4e86\u5b9e\u73b0\u6d4b\u8bd5\u91d1\u5b57\u5854\u548c\u5728\u5c3d\u53ef\u80fd\u9ad8\u7684\u62bd\u8c61\u7ea7\u522b\u7f16\u5199\u5355\u5143\u6d4b\u8bd5\u3002</li> </ul>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_6","title":"\u7b2c\u4e8c\u90e8\u5206","text":"<ul> <li>\u4e8b\u4ef6\u9a71\u52a8\u67b6\u6784\uff08\u7b2c 8-11 \u7ae0\uff09\uff1a\u6211\u4eec\u4ecb\u7ecd\u4e86\u53e6\u5916\u4e09\u4e2a\u76f8\u4e92\u652f\u6301\u7684\u6a21\u5f0f\uff1a\u9886\u57df\u4e8b\u4ef6\u3001\u6d88\u606f\u603b\u7ebf\u548c\u5904\u7406\u5668\u6a21\u5f0f\u3002\u9886\u57df\u4e8b\u4ef6\u662f\u6355\u83b7\u7cfb\u7edf\u4ea4\u4e92\u89e6\u53d1\u5176\u4ed6\u4ea4\u4e92\u7684\u4e00\u79cd\u65b9\u5f0f\u3002\u6211\u4eec\u4f7f\u7528\u6d88\u606f\u603b\u7ebf\u8ba9\u64cd\u4f5c\u89e6\u53d1\u4e8b\u4ef6\u5e76\u8c03\u7528\u9002\u5f53\u7684\u5904\u7406\u5668\u3002\u63a5\u7740\uff0c\u6211\u4eec\u8ba8\u8bba\u4e86\u5982\u4f55\u5c06\u4e8b\u4ef6\u7528\u4f5c\u5fae\u670d\u52a1\u67b6\u6784\u4e2d\u670d\u52a1\u96c6\u6210\u7684\u6a21\u5f0f\u3002</li> <li>\u547d\u4ee4\u67e5\u8be2\u804c\u8d23\u5206\u79bb\uff08\u7b2c 12 \u7ae0\uff09\uff1a\u6211\u4eec\u5c55\u793a\u4e86\u547d\u4ee4\u67e5\u8be2\u804c\u8d23\u5206\u79bb\u7684\u793a\u4f8b\uff0c\u5305\u62ec\u4f7f\u7528\u548c\u4e0d\u4f7f\u7528\u4e8b\u4ef6\u7684\u60c5\u51b5\u3002</li> <li>\u4f9d\u8d56\u6ce8\u5165\uff08\u7b2c 13 \u7ae0\uff09\uff1a\u6211\u4eec\u6574\u7406\u4e86\u663e\u5f0f\u548c\u9690\u5f0f\u4f9d\u8d56\uff0c\u5e76\u5b9e\u73b0\u4e86\u4e00\u4e2a\u7b80\u5355\u7684\u4f9d\u8d56\u6ce8\u5165\u6846\u67b6\u3002</li> </ul>"},{"location":"%E4%B9%A6%E7%B1%8D/Architecture-Patterns-with-Python/Preface/#_7","title":"\u672c\u4e66\u4f7f\u7528\u7684\u7ea6\u5b9a","text":"<ul> <li> <p>\u63d0\u793a\ud83d\udca1: \u6b64\u5143\u7d20\u8868\u793a\u63d0\u793a\u6216\u5efa\u8bae\u3002</p> </li> <li> <p>\u6ce8\u610f\ud83e\udd14: \u6b64\u5143\u7d20\u8868\u793a\u4e00\u822c\u8bf4\u660e\u3002</p> </li> <li> <p>\u8b66\u544a\ud83e\udd8a: \u6b64\u5143\u7d20\u8868\u793a\u8b66\u544a\u6216\u6ce8\u610f\u4e8b\u9879\u3002</p> </li> </ul>"},{"location":"%E6%8A%80%E6%9C%AF/AI%E5%BA%94%E7%94%A8%E5%BC%80%E5%8F%91/langgraph%E7%AC%94%E8%AE%B0/langgraph%E7%AC%AC%E4%B8%80%E7%AF%87%E4%BB%8B%E7%BB%8D/","title":"\u4f7f\u7528Langgraph\u5f00\u53d1\u667a\u80fd\u4f53\u5e94\u7528","text":""},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/agents%E9%9D%A2%E8%AF%95%E9%A2%98/","title":"agents\u9762\u8bd5\u9898\u51c6\u5907","text":""},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/agents%E9%9D%A2%E8%AF%95%E9%A2%98/#1-agent","title":"1. \u4ecb\u7ecd\u4e00\u4e0bagent\u54ea\u4e9b\u90e8\u5206\u7ec4\u6210","text":""},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/agents%E9%9D%A2%E8%AF%95%E9%A2%98/#11","title":"1.1 \u4ecb\u7ecd\u4e00\u4e0b\u5de5\u5177\u4f7f\u7528","text":"\u8be6\u7ec6\u89e3\u7b54 <p>\u5bf9\u6a21\u578b\u6743\u91cd\u4e22\u5931\u6389\u7684\u4fe1\u606f\uff0cagent\u53ef\u4ee5\u8c03\u7528\u5916\u90e8api\u83b7\u53d6\u989d\u5916\u4fe1\u606f\uff0c\u5305\u62ec\u5f53\u524d\u4fe1\u606f\u3001\u4ee3\u7801\u6267\u884c\u80fd\u529b\u3001\u4e13\u6709\u4fe1\u606f\u6e90\u7684\u8bbf\u95ee\u7b49\u3002</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/agents%E9%9D%A2%E8%AF%95%E9%A2%98/#12","title":"1.2 \u62c6\u89e3\u4efb\u52a1\u6216\u8005\u8bf4\u4efb\u52a1\u5206\u89e3\u6709\u54ea\u4e9b\u65b9\u6cd5\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <p>1\ufe0f\u20e3 <code>CoT</code>(chain of thoughts): \u6a21\u578b\u88ab\u8981\u6c42<code>step by step</code>\u5229\u7528\u66f4\u591a\u7684\u65f6\u95f4\u8fdb\u884c\u8ba1\u7b97\uff0c\u5c06\u96be\u4efb\u52a1\u5206\u89e3\u4e3a\u66f4\u5c0f\u66f4\u7b80\u5355\u7684\u6b65\u9aa4\u3002CoT\u5c06\u5927\u578b\u4efb\u52a1\u8f6c\u6362\u4e3a\u591a\u4e2a\u53ef\u7ba1\u7406\u7684\u4efb\u52a1\u3002\u53ef\u4ee5\u53c2\u8003<code>langmanus</code>\u4e2d\u7684<code>planner node</code>\uff0c\u5176\u4e2d\u63d0\u793a\u8bcd\u5982\u4e0b:</p> <pre><code>## Execution Rules\n\n- To begin with, repeat user's requirement in your own words as `thought`.\n- Create a step-by-step plan.\n- Specify the agent **responsibility** and **output** in steps's `description` for each step. Include a `note` if necessary.\n- Ensure all mathematical calculations are assigned to `coder`. Use self-reminder methods to prompt yourself.\n- Merge consecutive steps assigned to the same agent into a single step.\n- Use the same language as the user to generate the plan.\n</code></pre> <p>2\ufe0f\u20e3 \u7c7b\u4f3c\u7684\u8fd8\u6709<code>ToT</code>(Tree of thounghts)\u548c<code>GoT</code>(Graph of thoughts)\u3002</p> <p>\ud83d\udcd6 GoT\u5305\u62ec\u4e86\u5355\u7ebf\u6761\u7684CoT\u548c\u591a\u5206\u679d\u7684ToT\u3002</p> <p>3\ufe0f\u20e3 \u8fd9\u4e9b\u7b56\u7565\u672c\u8d28\u662f\u901a\u8fc7Prompt\u7684\u7cbe\u5fc3\u8bbe\u8ba1\uff0c\u6fc0\u53d1\u51fa\u6a21\u578b\u539f\u6709\u7684<code>\u5143\u8ba4\u77e5</code>(Metacognition)\u7684\u80fd\u529b\uff0c\u5982\u4f55\u901a\u8fc7\u67d0\u6761\u795e\u7ecf\u5143\u7684\u7ebf\u7d22\u80fd\u66f4\u52a0\u7cbe\u51c6\u8c03\u52a8\u5927\u8111\u4e2d\u6700\u64c5\u957f<code>Planning</code>\u7684\u90e8\u5206\u3002</p> <p>\u53c2\u8003</p> <p></p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/agents%E9%9D%A2%E8%AF%95%E9%A2%98/#13","title":"1.3 \u6a21\u578b\u5982\u4f55\u81ea\u6211\u53cd\u7701\uff1f\u53cd\u7701\u7684\u65b9\u6cd5\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <ol> <li>\u5982\u4f55\uff1f-&gt; \u81ea\u67e5\u81ea\u7ea0\uff1aAgent\u80fd\u591f\u5bf9\u8fc7\u53bb\u7684action\u8fdb\u884c\u81ea\u6211\u6279\u8bc4\u548c\u53cd\u7701\uff0c\u4ece\u9519\u8bef\u4e2d\u5438\u53d6\u6559\u8bad\uff0c\u5728\u540e\u7eed\u5de5\u4f5c\u52a0\u4ee5\u6539\u8fdb\uff0c\u6700\u7ec8\u63d0\u5347\u7ed3\u679c\u8d28\u91cf\u3002</li> <li>\u53cd\u7701\u7684\u65b9\u6cd5\uff1a <code>ReAct</code>\ud83c\udfaf\u5373Reason + Act\uff0c\u5728LLM\u5185\u90e8\u6574\u5408\u4e86\u63a8\u7406\u548c\u884c\u52a8\u3002\u6a21\u7248\u5927\u81f4\u5982\u4e0b\uff1a   <pre><code>Thought: ...\nAction: ...\nObservation: ...\n</code></pre></li> </ol>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/","title":"\u5927\u6a21\u578b <code>Langchain</code> \u9762\u8bd5\u9898\u51c6\u5907","text":""},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#1-langchain","title":"1. <code>langchain</code>\u5305\u542b\u54ea\u4e9b\u6838\u5fc3\u6982\u5ff5?","text":""},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#11-langchain-components-chains","title":"1.1 langchain \u7684 components \u548c chains \u662f\u4ec0\u4e48\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <p>Components\uff1a\u6a21\u5757\u5316\u7684\u6784\u5efa\u5757\uff0c\u53ef\u4ee5\u642d\u79ef\u6728\u521b\u5efa\u5e94\u7528\u7a0b\u5e8f</p> <p>Chains\uff1a\u7ec4\u5408\u5728\u4e00\u8d77\u4ee5\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\u7684\u4e00\u7cfb\u5217<code>Components</code>\uff08\u6216<code>Chains</code>\uff09</p> <p>\u4e00\u4e2a<code>chain</code>\u53ef\u80fd\u5305\u62ec\u4e00\u4e2a<code>Prompt</code>\u6a21\u7248\u3001\u4e00\u4e2a\u8bed\u8a00\u6a21\u578b\u4e00\u4e2a\u8f93\u51fa\u89e3\u91ca\u5668\uff08ICEL\u94fe\u5f0f\u8c03\u7528\uff09\uff0c\u8fd9\u4e9b\u4e00\u8d77\u5de5\u4f5c\u5b8c\u6210\u4efb\u52a1</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#12-langchain-embedding-vector-store","title":"1.2 langchain \u5982\u4f55 Embedding \u548c vector store\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <p>\u4e00\u822c\u5e38\u89c4\u68c0\u7d22\u662f\u628a\u6570\u636e\u90fd\u5148<code>embedding</code>\u5165\u5e93\uff0c\u5728\u670d\u52a1\u9636\u6bb5<code>query</code>\u8fdb\u6765<code>embedding</code>\u540e\u518d\u5feb\u901f\u5728\u5e93\u4e2d\u67e5\u8be2\u76f8\u4f3c<code>topk</code>\uff0c\u7136\u540e\u6574\u5408\u8fd4\u56de\u7ed9\u6a21\u578b\u3002</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#13-langchainagents","title":"1.3 langchain\u7684agents\u539f\u7406\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <p>Agents\u6d41\u7a0b\u5305\u542b\u4e0b\u9762\u56db\u4e2a\u6838\u5fc3\u6b65\u9aa4\uff1a</p> <ol> <li> <p>\u63a5\u53d7\u4efb\u52a1</p> </li> <li> <p>\u601d\u8003\uff1a \u5229\u7528LLM\u8fdb\u884c\u63a8\u7406\u548c\u51b3\u7b56\u3002\u5982\u53ef\u80fd\u751f\u6210\u4e00\u4e2a\u6f5c\u5728\u7684\u89e3\u51b3\u65b9\u6848\uff08\u5982langmanus\u4e2d\u7684planner node\uff09</p> </li> <li> <p>\u884c\u52a8\uff1a\u63a5\u4e0b\u6765\uff0cLLM Agent \u4f1a\u6839\u636e\u4efb\u52a1\u548c\u601d\u8003\u7ed3\u679c\uff0c\u6267\u884c\u4e00\u4e9b\u64cd\u4f5c\uff0c\u6bd4\u5982\u8c03\u7528API\u3001\u8bbf\u95ee\u6570\u636e\u5e93\u7b49</p> </li> <li> <p>\u63a5\u6536\u53cd\u9988\uff1a\u6267\u884c\u64cd\u4f5c\u540eLLM Agent\u4f1a\u63a5\u6536\u5230\u6765\u81ea\u73af\u5883\u7684\u53cd\u9988\uff08\u53ef\u80fd\u5305\u62ecAPI\u7684\u54cd\u5e94\u3001\u6570\u636e\u5e93\u7684\u67e5\u8be2\u7ed3\u679c\u7b49\uff09</p> </li> </ol>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#14-langchain","title":"1.4 langchain\u5982\u4f55\u4fee\u6539\u63d0\u793a\u6a21\u7248?","text":"\u8be6\u7ec6\u89e3\u7b54 <p>\u4f7f\u7528<code>from langchain import PromptTemplate</code>\uff0c\u5177\u4f53\u5b9e\u73b0\u5982\u4e0b\uff1a <pre><code>from langchain import PromptTemplate\n\nprompt = PromptTemplate(\n    template=self.config.prompt_template,\n    input_variables=[\"context\", \"question\", \"history\"]\n)\n</code></pre></p> <p>\u6ce8\u610f</p> <p>\u5728PromptTemplate\u4e2d\uff0c<code>input_variables</code>\u5fc5\u987b\u662f\u6a21\u7248\u5b57\u7b26\u4e32\u4e2d\u6240\u6709\u7528<code>{}</code>\u5305\u88f9\u7684\u53d8\u91cf\u540d\u3002</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#15-langchain","title":"1.5 langchain\u5982\u4f55\u5b9e\u73b0\u591a\u8f6e\u5bf9\u8bdd?","text":"\u8be6\u7ec6\u89e3\u7b54 <p>\u5728langchain\u4e2d\u5b9e\u73b0\u591a\u8f6e\u5bf9\u8bdd\uff0c\u9700\u8981\u4f7f\u7528<code>ConversationBufferMemory</code>\u6765\u5b58\u50a8\u5bf9\u8bdd\u5386\u53f2\uff1a</p> <pre><code>from langchain.memory import ConversationBufferMemory\n\n# \u521b\u5efa\u8bb0\u5fc6\u7ec4\u4ef6\nmemory = ConversationBufferMemory(\n    memory_key=\"chat_history\",\n    return_messages=True\n)\n\n# \u5728\u94fe\u4e2d\u4f7f\u7528\u8bb0\u5fc6\u7ec4\u4ef6\nconversation = ConversationChain(\n    llm=llm,\n    memory=memory,\n    verbose=True\n)\n\n# \u8fdb\u884c\u591a\u8f6e\u5bf9\u8bdd\nresponse1 = conversation.predict(input=\"\u4f60\u597d\uff01\")\nresponse2 = conversation.predict(input=\"\u6211\u60f3\u4e86\u89e3\u66f4\u591a\u5173\u4e8elangchain\u7684\u4fe1\u606f\")\n</code></pre> <p>\u8fd9\u6837\uff0c\u7b2c\u4e8c\u6b21\u5bf9\u8bdd\u4f1a\u81ea\u52a8\u5305\u542b\u7b2c\u4e00\u6b21\u5bf9\u8bdd\u7684\u4e0a\u4e0b\u6587\u3002</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#16-mcpfunction-calling","title":"1.6 MCP\u548cFunction Calling\u7684\u533a\u522b\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <p>Function Calling\u7279\u70b9\uff1a</p> <ol> <li> <p>\u5c06\u81ea\u7136\u8bed\u8a00\u8f6c\u6362\u4e3a\u53ef\u6267\u884c\u7684\u51fd\u6570\u8c03\u7528\u6307\u4ee4\uff0c\u4f46\u662f\u5404\u5927\u5382\u7684\u5b9e\u73b0\u65b9\u5f0f\u4e0d\u540c</p> </li> <li> <p>\u4e0d\u540c\u5e73\u53f0\u5b9e\u73b0\u5dee\u5f02\u5927\uff0c\u5207\u6362\u6a21\u578b\u9700\u9002\u914d\u4ee3\u7801</p> </li> <li> <p>\u5927\u6a21\u578b\u7684\u63d2\u4ef6\u8c03\u7528\u673a\u5236</p> </li> </ol> <p>MCP\u7279\u70b9\uff1a</p> <ol> <li> <p>\u7c7b\u4f3cUSB-C\uff0c\u662f\u5f00\u653e\u7684\u901a\u7528\u534f\u8bae\u6807\u51c6</p> </li> <li> <p>\u652f\u6301\u8de8\u5e73\u53f0\uff0c\u6a21\u578b\u5207\u6362\u65e0\u9700\u91cd\u5199\u4ee3\u7801, \u4e00\u6b21\u5f00\u53d1\u591a\u5e73\u53f0\u590d\u7528</p> </li> <li> <p>AI\u4e8e\u5916\u90e8\u5de5\u5177\u4ea4\u4e92\u7684\u4e2d\u95f4\u5c42\u534f\u8bae</p> </li> <li> <p>\u654f\u611f\u6570\u636e\u672c\u5730\u5316\u5904\u7406\u4fdd\u969c\u5b89\u5168</p> </li> </ol> <p>\u53c2\u8003</p> <p>\u4ec0\u4e48\u662fMCP\uff1f\u5b83\u5230\u5e95\u6709\u4ec0\u4e48\u7528\uff1f</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/langchain%E9%9D%A2/langchain%E9%9D%A2%E8%AF%95%E9%A2%98%E5%87%86%E5%A4%87/#17","title":"1.7 \u4ec0\u4e48\u662f\u5411\u91cf\u6570\u636e\u5e93\uff1f\u5728\u5927\u6a21\u578b\u5e94\u7528\u4e2d\u4e3b\u8981\u89e3\u51b3\u4ec0\u4e48\u95ee\u9898\uff1f","text":"\u8be6\u7ec6\u89e3\u7b54 <p>\u5411\u91cf\u6570\u636e\u5e93\uff1a \u5b58\u50a8\uff08\u5d4c\u5165\uff09\u548c\u7ba1\u7406\u5411\u91cf\u6570\u636e\u7684\u6570\u636e\u5e93\uff0c\u53ef\u4ee5\u5c06\u975e\u7ed3\u6784\u5316\u6570\u636e\uff08\u5982\u6587\u672c\u3001\u56fe\u7247\u3001\u97f3\u9891\u7b49\uff09\u8f6c\u6362\u4e3a\u9ad8\u7ef4\u5411\u91cf\u7684\u5f62\u5f0f\u8fdb\u884c\u5b58\u50a8\uff0c\u5e76\u63d0\u4f9b\u9ad8\u6548\u7684\u76f8\u4f3c\u6027\u641c\u7d22\u529f\u80fd\u3002</p> <p>\u4f8b\u5982\uff1aQdrant\u3001Chroma\u3001FAISS\u3001Pinecone</p> <p>\u5728\u5927\u6a21\u578b\u5e94\u7528\u4e2d\u4e3b\u8981\u89e3\u51b3\u7684\u95ee\u9898\uff1a</p> <ol> <li> <p>\u901a\u8fc7\u5c06\u7528\u6237\u67e5\u8be2\u8f6c\u4e3a\u5411\u91cf\uff0c\u53ef\u4ee5\u5feb\u901f\u627e\u5230\u8bed\u4e49\u76f8\u4f3c\u7684topk\u5185\u5bb9\uff0c\u5bf9\u4e8e\u667a\u80fd\u6587\u6863\u548c\u63a8\u8350\u7cfb\u7edf\u975e\u5e38\u6709\u7528\u3002</p> </li> <li></li> </ol>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/python%E9%9D%A2/5-1_%E8%A3%85%E9%A5%B0%E5%99%A8/","title":"\u88c5\u9970\u5668\u5e38\u89c1\u8003\u9898","text":"<p>\u7ed9\u4e00\u4e2a\u7c7b\u6269\u5145\u529f\u80fd\uff0c\u901a\u5e38\u4f7f\u7528<code>\u7ec4\u5408</code>\u6216\u8005<code>\u7ee7\u627f</code>\u3002</p>"},{"location":"%E6%8A%80%E6%9C%AF/%E9%9D%A2%E8%AF%95%E9%87%91%E9%92%A5/python%E9%9D%A2/5-1_%E8%A3%85%E9%A5%B0%E5%99%A8/#_2","title":"\u4f7f\u7528\u7c7b\u88c5\u9970\u5668\u6bd4\u8f83\u65b9\u4fbf\u5b9e\u73b0\u88c5\u9970\u5668\u53c2\u6570","text":"<pre><code>import time\n\n\nclass LogTime:\n    def __call__(self, func):\n        def _log(*args, **kwargs):\n            start = time.time()\n            res = func(*args, **kwargs)\n            print(f\"used time: {time.time() - start}\")\n            return res\n        return _log\n\n\n@LogTime()\ndef mysleep():\n    time.sleep(2)\n\n\nmysleep()\n</code></pre> <p>\u5982\u4f55\u7ed9\u88c5\u9970\u5668\u52a0\u53c2\u6570\uff1f\u53c2\u8003\u4e0b\u9762\u7684\u4ee3\u7801\uff1a</p> <pre><code>import time\n\n\nclass LogTime:\n    def __init__(self, use_int=False):\n        self.use_int = use_int\n\n    def __call__(self, func):\n        def _log(*args, **kwargs):\n            start = time.time()\n            res = func(*args, **kwargs)\n            if self.use_int:\n                print(\"used time: {}\".format(int(time.time() - start)))\n            else:\n                print(f\"used time: {time.time() - start}\")\n            return res\n        return _log\n\n@LogTime(True)  # \u8fd9\u91cc\u4f7f\u7528\u5b9a\u4e49\u597d\u7684\u53c2\u6570\ndef mysleep():\n    time.sleep(2)\n\nmysleep()\n</code></pre>"},{"location":"%E6%97%A5%E5%B8%B8/%E5%A4%87%E5%BF%98/","title":"\u5907\u5fd8","text":""},{"location":"%E6%97%A5%E5%B8%B8/%E5%A4%87%E5%BF%98/#mkdocs","title":"mkdocs\u6587\u6863\u76f8\u5173","text":"<p>\u81ea\u5b9a\u4e49\u4fee\u6539</p>"}]}